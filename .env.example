# ---------------------------------------------------------------------------
# CHRONOS AI — 前端公开环境变量
# 只有 VITE_ 前缀的变量会被 Vite 暴露到浏览器，只能放非机密信息。
# 复制本文件为 .env.local 后填入真实值；.env.local 已被 .gitignore 忽略。
# ---------------------------------------------------------------------------

VITE_APP_NAME=CHRONOS AI
VITE_DEFAULT_LOCALE=zh-CN
VITE_DEFAULT_TIMEZONE=Asia/Singapore

# true = 强制 mock 模式；false = 在下方配置齐全时连接真实 Supabase
# 未填 Supabase 配置时，无论此值如何都会自动降级到 mock（保证网站可运行）
VITE_USE_MOCK=true

# Phase 2 接入：anon public key 可安全暴露，受 Supabase RLS 保护
# 填入真实值并将 VITE_USE_MOCK=false 即切换到真实后端（页面代码零改动）
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-public-key

# AI 网关地址（Edge Function / Vercel Serverless），不含任何密钥
VITE_AI_GATEWAY_URL=/api/ai

# ---------------------------------------------------------------------------
# 注意：以下为服务端机密，绝不写入前端、绝不提交 GitHub：
#   SUPABASE_SERVICE_ROLE_KEY
#   GEMINI_API_KEY
# 它们只存在于 Supabase Edge Function secrets 或 Vercel 环境变量中。
# ---------------------------------------------------------------------------
